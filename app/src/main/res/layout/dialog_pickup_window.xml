<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start time"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewPickupStartValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonSelectPickupStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Change Start Time" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="End time"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewPickupEndValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonSelectPickupEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Change End Time" />

    <TextView
        android:id="@+id/textViewPickupValidation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp" />
</LinearLayout>
